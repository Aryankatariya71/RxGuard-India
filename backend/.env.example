APP_NAME=RxGuard India
APP_VERSION=1.1.0
ENGINE_VERSION=engine-1.1.0
ENVIRONMENT=development
# demo=true → synthetic seed only; false → also import catalogue + rules
DEMO_MODE=true
DATASET_VERSION=demo-1.0
CATALOGUE_VERSION=demo-1.0
RULE_SET_VERSION=demo-1.0
# SQLite default (created under project data/):
DATABASE_URL=sqlite:///./data/rxguard.db
# Or PostgreSQL / Supabase:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
